    "modules": {
      "Camera": {},
      "VideoPlayer": {}
    },
    "distribute": {
      "apple": {
        "appid": "",
        "mobileprovision": "",
        "password": "",
        "p12": "",
        "embed": "",
        "devices": "iphone",
        "frameworks": []
      },
      "icons": {
        "ios": {
          "prerendered": true,
          "auto": "xxx/xxx.png"
        }
      },
      "permissions": {
        "NSPhotoLibraryUsageDescription": "需要访问相册以选择食物照片",
        "NSCameraUsageDescription": "需要使用相机拍摄食物照片",
        "NSMicrophoneUsageDescription": "需要麦克风用于语音输入评论"
      }
    }
  },
  "quickapp": {},
  "mp-weixin": {
    "appid": "",
    "setting": { "urlCheck": false },
    "usingComponents": true
  },
  "vueVersion": "2"
